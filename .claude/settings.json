{
  "extraKnownMarketplaces": {
    "dstack": {
      "source": {
        "source": "github",
        "repo": "gosuda/dalcom-skills"
      }
    }
  },
  "enabledPlugins": {
    "dstack-core@dstack": true,
    "dstack-code@dstack": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
